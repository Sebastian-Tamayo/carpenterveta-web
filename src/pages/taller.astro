---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Workshop from "../components/Workshop.astro";
import Contact from "../components/Contact.astro";
---

<BaseLayout
  title="El Taller — CarpenterVeta"
  description="Vídeos, directos y contenido del taller CarpenterVeta. Transparencia sobre fabricación, materiales y acabados."
  canonical="/taller"
>
  <Header tone="light" />
  <main id="contenido">
    <header class="page-hero wrap">
      <span class="section__eyebrow">Multimedia</span>
      <h1 class="section__title">El Taller, en abierto.</h1>
      <p class="section__lead">
        Grabaciones, directos y redes para ver cómo se fabrica tu mueble antes de encargarlo — sin visitas obligatorias.
      </p>
    </header>
    <Workshop />
    <Contact />
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-h) + 3.5rem);
    padding-bottom: var(--space-4);
  }
</style>
